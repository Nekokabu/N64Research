From 017b8f5599d9b6ed2d9c710662246b201c517576 Mon Sep 17 00:00:00 2001
From: Nekokabu <nekokabu@gmail.com>
Date: Thu, 19 Nov 2026 22:28:43 +0900
Subject: [PATCH 32/32] n64: the AI beside a running graphics task; texture
 loads from the megabyte the VI shows (task_timing v26)

Two smaller things a game has and the replays did not, measured with
task_timing v26 on six of Beetle Adventure Racing's tasks (go to RSP
halt, VI):

- The AI playing as in the game (22047 Hz, its buffers in the megabyte
  of the output FIFO): +0.0022 to 0.0062 with the VI off, +0.0036 to
  0.0076 in the game's VI mode. The model had 5.4 clocks per sample
  (rdp_timing v54, lists handed to the RDP whole): +0.0009 to 0.0022.
  While the RSP runs a sample now costs 14 clocks, scaled by the VI as
  an SP DMA is: +0.0023 to 0.0059 and +0.0029 to 0.0074.
- The VI showing the buffer the game showed instead of a picture in a
  megabyte the task does not touch: +0.0010 to 0.0051, nearly all of it
  in DPC_TMEM (+3.4%): the texture loads whose source is in that
  megabyte (113 of the frame's 115 textures are in the megabytes of the
  two frame buffers). A load from the megabyte the VI shows now takes 5%
  longer while the VI reads the picture (AA modes 0 / 1): +0.0010 to
  0.0052 (was +0.0004 to 0.0020).

Not modelled: the VI showing the buffer being drawn or the depth buffer
(+0.013 to 0.046 VI on the same tasks; no game here does that for a
whole frame).

Results (console): Beetle Adventure Racing intro, first scene 230
frames (231), go to RSP done by blocks of 20 frames +0.1 / -3.4 / +1.2
/ -1.7 / +0.9 / +1.2 / +0.6 / +1.2 / -1.3 / -0.9 / +0.1% (series v25:
-1.0 / -6.2 / -0.3 / -2.8 / +0.1 / +0.1 / -2.6 / +0.2 / -1.8 / -2.6 /
-4.7%); second scene 317 (325). Donkey Kong 64 and the MGC demo as with
the previous patch. The same task in the game minus replayed: console
+0.025 to 0.040 VI, model +0.017 to 0.024.
---
 ares/n64/rdp/rdp.hpp    |  9 +++++++++
 ares/n64/rdp/timing.cpp | 23 +++++++++++++++++++----
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/ares/n64/rdp/rdp.hpp b/ares/n64/rdp/rdp.hpp
index 778539b6..e05cb456 100644
--- a/ares/n64/rdp/rdp.hpp
+++ b/ares/n64/rdp/rdp.hpp
@@ -84,6 +84,7 @@ struct RDP : Thread, Memory::RCP<RDP> {
   auto contendScale(u32 kind) -> f64;
   auto viPictureFactor() -> f64;
   auto timingVi(f64 cost) -> f64;
+  auto timingLoad(f64 cost) -> f64;
   enum : u32 { CpuDataFill, CpuInstructionFill, CpuWriteBack, CpuUncachedWrite };
   auto timingCpu(u32 kind, f64 clocks, u32 address) -> f64;
   auto timingLoss(f64 cost, f64 data, f64 instruction) -> void;
@@ -121,6 +122,14 @@ struct RDP : Thread, Memory::RCP<RDP> {
     //RDP clocks lost to each sample the AI fetches from RDRAM (rdp_timing v54: 28458 clocks over 10473 samples
     //with the buffer in an unrelated megabyte, 27807 / 4706 in the colour buffer's, 25571 / 4706 in the command list's)
     f64    audioSample = 2.7, audioSampleColor = 5.9, audioSampleList = 5.4;
+    //beside a running graphics task the same fetch costs more: six of Beetle Adventure Racing's tasks replayed with the AI
+    //playing as in the game (22047 Hz, its buffers in the megabyte of the output FIFO) take 0.0022 to 0.0062 VI longer with
+    //the VI off and 0.0036 to 0.0076 VI in the game's VI mode (task_timing v26); 14 clocks per sample while the RSP runs,
+    //scaled by the VI as an SP DMA is, gives 0.0023 to 0.0059 and 0.0029 to 0.0074
+    f64    audioSampleListTask = 14.0;
+    //a texture load whose source is in the megabyte the VI shows, AA modes 0 / 1: so much longer while the VI reads the
+    //picture (task_timing v26: DPC_TMEM +3.4% with the VI on the buffer the game showed, the other masters unchanged)
+    f64    loadVi = 0.05;
     //the other bus masters are charged as they happen (timingDelay) instead of a fixed factor
     f64    contentionZ = 1.0;      //scale on read-modify-write spans (image read / depth) beyond the per-transfer charges below
     f64    contentionPlain = 1.0;  //the same for write-only spans (plain 1/2-cycle, fill, copy) and TMEM loads
diff --git a/ares/n64/rdp/timing.cpp b/ares/n64/rdp/timing.cpp
index 567a9791..684ae07d 100644
--- a/ares/n64/rdp/timing.cpp
+++ b/ares/n64/rdp/timing.cpp
@@ -92,7 +92,10 @@ auto RDP::timingAudio(u32 address) -> void {
   u32 megabyte = (address & 0xffffff) >> 20;
   f64 clocks = timing.audioSample;
   if(megabyte == (timing.colorAddress & 0xffffff) >> 20) clocks = timing.audioSampleColor;
-  else if(!command.source && megabyte == (u32)command.current >> 20) clocks = timing.audioSampleList;
+  else if(!command.source && megabyte == (u32)command.current >> 20) {
+    clocks = timing.audioSampleList;
+    if(!rsp.status.halted) clocks = timing.audioSampleListTask * contendScale(ContendDma);  //a task feeding the list
+  }
   timingDelay(clocks);
 }
 
@@ -208,6 +211,18 @@ auto RDP::timingVi(f64 cost) -> f64 {
   return cost + part;
 }
 
+//a texture load: as timingVi, and more of it when the texture is in the megabyte the VI shows
+auto RDP::timingLoad(f64 cost) -> f64 {
+  cost *= timingScale(false);
+  f64 priced = timingVi(cost);
+  if(vi.active() && vi.io.antialias < 2 && (timing.textureAddress & 0xffffff) >> 20 == ((u32)vi.io.dramAddress & 0xffffff) >> 20) {
+    f64 part = cost * timing.loadVi;
+    timing.viPart += part;
+    priced += part;
+  }
+  return priced;
+}
+
 //how much the VI's framebuffer fetch slows the RDP in the current VI mode while it reads the picture (see rdp.hpp)
 auto RDP::viPictureFactor() -> f64 {
   if(!vi.active()) return 1.0;
@@ -689,7 +704,7 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
   case 0x30: { //Load_TLUT
     s32 s0 = n12(op >> 44) >> 2, s1 = n12(op >> 12) >> 2;
     u32 count = s1 >= s0 ? s1 - s0 + 1 : 0;
-    f64 cost = timingVi(rdp_tm_load_tlut(count) * timingScale(false));
+    f64 cost = timingLoad(rdp_tm_load_tlut(count));
     timingLoss(cost, timing.cpuLoad[0], timing.cpuLoad[1]);
     timingAdd(cost);
   } break;
@@ -698,7 +713,7 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
     s32 s0 = n12(op >> 44), s1 = n12(op >> 12);
     u32 texels = s1 >= s0 ? s1 - s0 + 1 : 0;
     u32 bytes = texelBytes2(texels) >> 1;
-    f64 cost = timingVi(rdp_tm_load_block((bytes + 1) >> 1) * timingScale(false));
+    f64 cost = timingLoad(rdp_tm_load_block((bytes + 1) >> 1));
     timingLoss(cost, timing.cpuLoad[0], timing.cpuLoad[1]);
     timingAdd(cost);
   } break;
@@ -715,7 +730,7 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
     //rows of the source image further apart than 512 / 1024 bytes cost 1.2 / 2.3 clocks more each (rdp_timing v34: a 32x32
     //RGBA16 tile out of a 320-pixel-wide image +4.8%, out of a 640-pixel-wide one +8.5%)
     f64 strideCost = stride >= 1024 ? timing.loadStrideWide : stride >= 512 ? timing.loadStride : 0.0;
-    f64 cost = timingVi((rdp_tm_load_tile(address, stride, rowBytes, h) + strideCost * h) * timingScale(false));
+    f64 cost = timingLoad(rdp_tm_load_tile(address, stride, rowBytes, h) + strideCost * h);
     timingLoss(cost, timing.cpuLoad[0], timing.cpuLoad[1]);
     timingAdd(cost);
   } break;
-- 
