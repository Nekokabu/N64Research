-    for(s32 row = py0; row < py1; row++) cycles += timingSpan(px0, row, width);
+    for(s32 row = py0; row < py1; row++) cycles += timingSpan(px0, row, width, true);
   }
   cycles += rdp_tm_prim_overhead((enum rdp_tm_mode)timing.mode, width ? width : 1);
   timingAdd(cycles, timingPlacement(py0));
@@ -488,6 +535,14 @@ auto RDP::timingSyncFull() -> void {
     timingComplete();
   }
   timing.syncTargets[timing.syncQueued++] = timing.submitted;
+  //what a CPU cache line fill costs the RDP beside the next frame: this frame's average over its time (timingLoss);
+  //the time that is neither span nor load counts with cpuRest
+  if(timing.frameWork > 0.0) {
+    f64 rest = timing.frameWork > timing.lossWork ? timing.frameWork - timing.lossWork : 0.0;
+    timing.cpuLossData = (timing.lossData + rest * timing.cpuRest[0]) / (timing.lossWork + rest);
+    timing.cpuLossInstruction = (timing.lossInstruction + rest * timing.cpuRest[1]) / (timing.lossWork + rest);
+  }
+  timing.lossData = timing.lossInstruction = timing.lossWork = timing.frameWork = 0.0;
 }
 
