From 8d8efb24b8e27e306495651afce31e1e90f3149d Mon Sep 17 00:00:00 2001
From: Nekokabu <nekokabu@gmail.com>
Date: Sun, 8 Nov 2026 21:49:33 +0900
Subject: [PATCH] n64: depth buffer in the colour buffer's megabyte, Load_Tile
 source stride (rdp_timing v34/v35)

Two effects measured on the console that the tables did not carry:

- a depth-tested span whose depth buffer row lies in the same megabyte of
  RDRAM as its colour buffer row costs 10% more up to 8 pixels and 16.5%
  (2-cycle) / 20% (1-cycle) more beyond, however far apart the two buffers
  are inside that megabyte (adjacent, 300 KiB, 512 KiB, 768 KiB, depth
  below colour: all the same); in different megabytes, or for spans that
  only read the colour buffer or write only, nothing. Set_Mask_Image is now
  parsed for the depth address. Donkey Kong 64, Beetle Adventure Racing and
  the MGC 2011 demo keep the two in different megabytes and are unchanged;
  4 MiB games commonly do not.
- a Load_Tile whose source rows are 512 bytes or more apart costs 1.2
  clocks more per row, 1024 bytes or more 2.3 clocks (a 32x32 RGBA16 tile
  out of a 320-pixel-wide image +4.8%, out of a 640-pixel-wide one +8.5%).
  Loads of every other format and size, Load_Block and Load_TLUT are within
  1-3% of the tables.

Measured on the synthetic series only; the wide-fill and depth/blend
rectangle differences of v34 are left out (see the report).
---
 ares/n64/rdp/rdp.hpp           |  8 +++++++-
 ares/n64/rdp/serialization.cpp |  1 +
 ares/n64/rdp/timing.cpp        | 23 +++++++++++++++++++++--
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/ares/n64/rdp/rdp.hpp b/ares/n64/rdp/rdp.hpp
index 8a604973..465dec4a 100644
--- a/ares/n64/rdp/rdp.hpp
+++ b/ares/n64/rdp/rdp.hpp
@@ -126,7 +126,12 @@ struct RDP : Thread, Memory::RCP<RDP> {
     f64    writeOnlySpanWide = 2.8;  //the same for a colour image wider than 320 pixels (the MGC 2011 demo's 640x480)
     f64    writeOnlyTri = 5.0;       //extra clocks per write-only triangle: edges (+5), shade words (+7), texture words (+30)
     f64    writeOnlyShade = 7.0;
-    f64    writeOnlyTexture = 30.0;       //clocks per span of an anti-aliased 1-cycle primitive (rdp_timing v24)
+    f64    writeOnlyTexture = 30.0;
+    f64    sameBankNarrow = 1.10;    //depth-tested span with the depth buffer in the colour buffer's megabyte of RDRAM, up to 8 px (rdp_timing v35)
+    f64    sameBank1 = 1.20;         //the same, wider spans, 1-cycle
+    f64    sameBank2 = 1.165;        //the same, wider spans, 2-cycle
+    f64    loadStride = 1.2;         //extra clocks per Load_Tile row when the source rows are 512..1023 bytes apart (rdp_timing v34)
+    f64    loadStrideWide = 2.3;     //the same, 1024 bytes or more
     n1     atomicPrim;             //Set_Other_Modes bits the model needs beyond the cycle type and depth/image read
     n1     antialias;
     u64    frameZPixels;           //depth-tested pixels drawn since the last Sync_Full
@@ -139,6 +144,7 @@ struct RDP : Thread, Memory::RCP<RDP> {
     n2     colorSize;              //0=4bpp 1=8bpp 2=16bpp 3=32bpp
     n10    colorWidth;
     n26    colorAddress;
+    n26    depthAddress;           //Set_Mask_Image
     n2     textureSize;
     n10    textureWidth;
     n26    textureAddress;
diff --git a/ares/n64/rdp/serialization.cpp b/ares/n64/rdp/serialization.cpp
index 88678057..34c57415 100644
--- a/ares/n64/rdp/serialization.cpp
+++ b/ares/n64/rdp/serialization.cpp
@@ -24,6 +24,7 @@ auto RDP::serialize(serializer& s) -> void {
   s(timing.colorSize);
   s(timing.colorWidth);
   s(timing.colorAddress);
+  s(timing.depthAddress);
   s(timing.textureSize);
   s(timing.textureWidth);
   s(timing.textureAddress);
diff --git a/ares/n64/rdp/timing.cpp b/ares/n64/rdp/timing.cpp
index eec118b0..4c8b1a35 100644
--- a/ares/n64/rdp/timing.cpp
+++ b/ares/n64/rdp/timing.cpp
@@ -63,6 +63,8 @@ auto RDP::timingReset() -> void {
   timing.atomicCost = t.atomicCost; timing.aaSpanCost = t.aaSpanCost;
   timing.writeOnlySpan = t.writeOnlySpan; timing.writeOnlySpanWide = t.writeOnlySpanWide;
   timing.writeOnlyTri = t.writeOnlyTri; timing.writeOnlyShade = t.writeOnlyShade; timing.writeOnlyTexture = t.writeOnlyTexture;
+  timing.sameBankNarrow = t.sameBankNarrow; timing.sameBank1 = t.sameBank1; timing.sameBank2 = t.sameBank2;
+  timing.loadStride = t.loadStride; timing.loadStrideWide = t.loadStrideWide;
   timing.colorSize = 2;
   timing.colorWidth = 319;
   timing.textureSize = 2;
@@ -203,7 +205,16 @@ auto RDP::timingSpan(s32 x, s32 y, u32 pixels) -> f64 {
   f64 pipe = pixels * timing.pipeCycles;
   if(cost < pipe) cost = pipe;
   cost *= timingScale(timing.memoryBound);
-  if(timing.memoryBound) cost += timing.spanPenalty;
+  if(timing.memoryBound) {
+    cost += timing.spanPenalty;
+    if(timing.zCompare || timing.zUpdate) {
+      //the depth buffer in the same megabyte of RDRAM as the colour buffer: every depth-tested span costs
+      //10% more up to 8 pixels and 16.5% (2-cycle) / 20% (1-cycle) more beyond, whatever the distance inside
+      //the megabyte (rdp_timing v24/v35); 4 MiB games commonly place both in the same megabyte
+      u32 depthRow = timing.depthAddress + y * (timing.colorWidth + 1) * 2;
+      if((depthRow >> 20) == (address >> 20)) cost *= w <= 8 ? timing.sameBankNarrow : timing.cycleType ? timing.sameBank2 : timing.sameBank1;
+    }
+  }
   else if(timing.cycleType < 2) {
     //write-only 1/2-cycle spans (no image read, no depth) cost a little more than the tables on the
     //console: +1.2 clocks per span into a 320-pixel-wide colour image and +2.8 into a 640-pixel-wide
@@ -424,7 +435,10 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
     u32 rowBytes = texelBytes2(w) >> 1;
     u32 address  = timing.textureAddress + t0 * stride + (texelBytes2(s0) >> 1);
     if(h > 1024) h = 1024;  //guard against garbage
-    timingAdd(rdp_tm_load_tile(address, stride, rowBytes, h) * timingScale(false));
+    //rows of the source image further apart than 512 / 1024 bytes cost 1.2 / 2.3 clocks more each (rdp_timing v34: a 32x32
+    //RGBA16 tile out of a 320-pixel-wide image +4.8%, out of a 640-pixel-wide one +8.5%)
+    f64 strideCost = stride >= 1024 ? timing.loadStrideWide : stride >= 512 ? timing.loadStride : 0.0;
+    timingAdd((rdp_tm_load_tile(address, stride, rowBytes, h) + strideCost * h) * timingScale(false));
   } break;
 
   case 0x36: { //Fill_Rectangle
@@ -440,6 +454,11 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
     timingAdd(state);
   } break;
 
+  case 0x3e: { //Set_Mask_Image
+    timing.depthAddress = n26(op >> 0);
+    timingAdd(state);
+  } break;
+
   case 0x3f: { //Set_Color_Image
     timing.colorSize    = n2(op >> 51);
     timing.colorWidth   = n10(op >> 32);
-- 
2.43.0

