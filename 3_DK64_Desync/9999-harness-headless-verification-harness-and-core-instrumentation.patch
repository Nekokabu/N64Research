+      Watch w; w.fmt = p.size() > 1 ? p[1] : string{"u32"};
+      if(p[0].beginsWith("p")) {  //pADDR+OFF : dereference pointer at ADDR then add OFF
+        string rest = p[0].slice(1);
+        auto q = nall::split(rest, "+");
+        w.deref = true; w.address = (u32)q[0].hex(); w.offset = q.size() > 1 ? (u32)q[1].hex() : 0;
+      } else w.address = (u32)p[0].hex();
+      harness.watches.push_back(w);
+    } else if(arg == "--input" && i + 1 < argc) {
+      harness.loadScript(argv[++i]);
+    } else if(arg == "--dump-every" && i + 1 < argc) {
+      harness.dumpEvery = string{argv[++i]}.natural();
+    } else if(arg == "--save" && i + 1 < argc) {
+      string spec = argv[++i];
+      auto p = nall::split(spec, "@");
+      savePath = p[0]; saveFrame = p.size() > 1 ? p[1].natural() : 0;
+    } else if(arg == "--load" && i + 1 < argc) {
+      loadPath = argv[++i];
+    } else if(arg == "--dumpram" && i + 1 < argc) {
+      string spec = argv[++i];
+      auto p = nall::split(spec, "@");
+      dumpPath = p[0]; dumpFrame = 0;
+      if(p.size() > 1) for(auto& f : nall::split(p[1], ",")) dumpFrames.push_back(f.natural());  //HARNESS: several frames -> path_<frame>
+    } else if(arg == "--poke" && i + 1 < argc) {
+      //--poke ADDR=VALUE32 : write a word into RDRAM after loading (code patch); caches/recompiler are invalidated
