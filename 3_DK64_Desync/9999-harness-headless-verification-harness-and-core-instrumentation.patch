+    } else if(arg == "--quiet") {
+      harness.quiet = true;
+    } else if(arg == "--model" && i + 1 < argc) {
+      modelFiles.push_back(argv[++i]);
+    }
+  }
+
+  ares::platform = &harness;
+
+  harness.game = mia::Medium::create("Nintendo 64");
+  if(harness.game->load(romPath) != successful) { print("failed to load rom\n"); return 1; }
+  harness.systemPak = mia::System::create("Nintendo 64");
