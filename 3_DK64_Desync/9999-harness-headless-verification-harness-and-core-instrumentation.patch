+  print("region: ", region, " id: ", harness.game->pak->attribute("id"), " cic: ", harness.game->pak->attribute("cic"), "\n");
+
+  ares::Nintendo64::option("Enable GPU acceleration", getenv("ARES_VULKAN") != nullptr);
+  ares::Nintendo64::option("Homebrew Mode", false);
+  ares::Nintendo64::option("Deterministic Entropy", true);
