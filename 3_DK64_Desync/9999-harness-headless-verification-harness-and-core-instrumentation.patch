+#include <algorithm>
+#include <unordered_map>
+// Minimal headless harness for the ares N64 core (debugging aid, not part of ares proper).
+// Usage: headless <rom> <vi-frames> [options]
+//   --watch ADDR[:fmt]   print the RAM value at physical address ADDR (hex) every VI frame (fmt: u8,u16,u32,f32)
+//   --input FILE         input script: lines "frame button[,button...]" (buttons: A,B,Z,Start,Up,Down,Left,Right,
+//                        L,R,CU,CD,CL,CR, X=<-128..127>, Y=<-128..127>); the state persists until the next line
+//   --dump-every N       dump the VI framebuffer as PPM every N VI frames (software scanout only)
+//   --quiet              suppress per-frame output
+#include <ares/ares.hpp>
+#include <mia/mia.hpp>
+#include <n64/n64.hpp>
+#include <nall/file.hpp>
+#include <cstdio>
+#include <map>
+#include <vector>
+#include <string>
+
+using namespace nall;
+
+namespace {
+
+struct Watch { u32 address; string fmt; bool deref = false; u32 offset = 0; };
+
+struct InputState {
+  s8 x = 0, y = 0;
+  bool a=0,b=0,z=0,start=0,up=0,down=0,left=0,right=0,l=0,r=0,cu=0,cd=0,cl=0,cr=0;
+};
+
+struct Harness : ares::Platform {
+  std::shared_ptr<mia::Pak> game, systemPak;
+  ares::Node::System root;
+  u64 viFrames = 0;
+  std::vector<Watch> watches;
+  std::map<u64, InputState> script;
+  InputState current;
+  u32 dumpEvery = 0;
+  bool quiet = false;
+  const u32* lastVideo = nullptr;
+  u32 lastPitch = 0, lastWidth = 0, lastHeight = 0;
+
+  auto pak(ares::Node::Object node) -> std::shared_ptr<vfs::directory> override {
+    if(node->name() == "Nintendo 64") return systemPak->pak;
+    if(node->name() == "Nintendo 64 Cartridge") return game->pak;
+    return {};
+  }
+
+  auto status(string_view message) -> void override { print("[status] ", message, "\n"); }
+
+  auto log(ares::Node::Debugger::Tracer::Tracer node, string_view message) -> void override {
+    if(node->terminal()) print(message);
+  }
+
+  auto video(ares::Node::Video::Screen, const u32* data, u32 pitch, u32 width, u32 height) -> void override {
+    if(dumpEvery && viFrames % dumpEvery == 0) {
+      string name = {"frame-", viFrames, ".ppm"};
+      FILE* fp = fopen(name.data(), "wb");
+      fprintf(fp, "P6\n%u %u\n255\n", width, height);
+      for(u32 y = 0; y < height; y++) {
+        const u32* line = (const u32*)((const u8*)data + y * pitch);
+        for(u32 x = 0; x < width; x++) {
+          u32 p = line[x];
+          u8 rgb[3] = {u8(p >> 16), u8(p >> 8), u8(p)};
+          fwrite(rgb, 1, 3, fp);
+        }
+      }
+      fclose(fp);
+    }
+  }
+
+  auto input(ares::Node::Input::Input node) -> void override {
+    auto name = node->name();
+    if(auto button = node->cast<ares::Node::Input::Button>()) {
+      bool v = false;
+      if(name == "A") v = current.a;
+      else if(name == "B") v = current.b;
+      else if(name == "Z") v = current.z;
+      else if(name == "Start") v = current.start;
+      else if(name == "Up") v = current.up;
+      else if(name == "Down") v = current.down;
+      else if(name == "Left") v = current.left;
+      else if(name == "Right") v = current.right;
+      else if(name == "L") v = current.l;
+      else if(name == "R") v = current.r;
+      else if(name == "C-Up") v = current.cu;
+      else if(name == "C-Down") v = current.cd;
+      else if(name == "C-Left") v = current.cl;
+      else if(name == "C-Right") v = current.cr;
+      button->setValue(v);
+    } else if(auto axis = node->cast<ares::Node::Input::Axis>()) {
+      if(name == "X-Axis") axis->setValue((s16)current.x * 256);
+      if(name == "Y-Axis") axis->setValue((s16)current.y * 256);
+    }
+  }
+
+  auto readRam(u32 address, const string& fmt, bool deref = false, u32 offset = 0) -> string {
+    using namespace ares::Nintendo64;
+    if(fmt == "dp") return {rdp.timing.syncFullCount};
+    if(fmt == "pc") return {hex((u32)cpu.ipu.pc, 8L)};
+    if(fmt == "vi") return {hex((u32)vi.io.dramAddress, 8L)};
+    if(fmt == "piprof") return {pi.dmaCount, "/", pi.dmaBytes, "/", pi.dmaClocks};
+    if(fmt == "rdpstat") { auto& t = rdp.timing; return {t.syncFullCount, "/", t.lastPixels, "/", t.lastSpans, "/", t.lastPrims, "/", t.lastRects, "/", t.lastLoadBytes, "/", t.lastFillPixels, "/", t.lastPipe, "/", t.lastMem, "/", t.lastDelay, "/", t.lastCycles, "/", (u32)(t.zPassFraction * 100)}; }
+    if(fmt == "dpsrc") return {rdp.command.source, "/", rdp.timing.frameCommandBytes};
+    if(fmt == "ucprof") return {cpu.uncachedReads, "/", cpu.uncachedWrites, "/", cpu.mmioReads, "/", cpu.mmioWrites};
+    if(fmt == "victrl") return {"ctrl ", hex(vi.lastControl, 8L), " depth", vi.io.colorDepth, " divot", vi.io.divot, " serrate", vi.io.serrate, " aa", vi.io.antialias, " width", vi.io.width, " xscale", vi.io.xscale, " yscale", vi.io.yscale, " v", vi.io.vstart, "-", vi.io.vend, " h", vi.io.hstart, "-", vi.io.hend};
+    if(fmt == "rdram") { string r; for(u32 n = 1; n < (u32)RBusDevice::NUM_RBUS_HW_DEVICES; n++) r.append(rdram.profile.metrics[n].reads + rdram.profile.metrics[n].writes, "/"); return r; }
+    if(fmt == "cpuprof") return {cpu.profile.cpuCycles, "/", cpu.profile.icacheMisses, "/", cpu.profile.dcacheMisses, "/", cpu.profile.dcacheWritebacks, "/", cpu.profile.dcacheHits, "/", cpu.stallCycles};
+    if(fmt == "dpcrsp") { string r; for(u32 n : range(8)) r.append(rdp.dpcRspReads[n], "/"); r.append(" w:"); for(u32 n : range(8)) r.append(rdp.dpcRspWrites[n], "/"); return r; }
+    if(fmt == "exc") { string r; for(u32 n : range(32)) if(cpu.exceptionCount[n]) r.append(n, "=", cpu.exceptionCount[n], " "); return r; }
+    if(fmt == "rspclk") return {rsp.busyClocks, "/", rsp.dmaCount, "/", rsp.dmaBytes};
+    if(fmt == "rspbusy") return {rsp.profile.cycles - rsp.profile.haltedCycles};
+    if(fmt == "rsphalt") return {rsp.profile.haltedCycles};
+    address &= 0x7fffff;
+    if(deref) {
+      u32 ptr = rdram.ram.read<Word>(address, RBusDevice::VR4300_UNCACHED);
+      if(!ptr) return "null";
+      address = (ptr + offset) & 0x7fffff;
+    }
+    if(fmt == "u8")  return {hex(rdram.ram.read<Byte>(address, RBusDevice::VR4300_UNCACHED), 2L)};
+    if(fmt == "u16") return {hex(rdram.ram.read<Half>(address, RBusDevice::VR4300_UNCACHED), 4L)};
+    if(fmt == "f32") { u32 v = rdram.ram.read<Word>(address, RBusDevice::VR4300_UNCACHED); float f; memcpy(&f, &v, 4); return {f}; }
+    return {hex(rdram.ram.read<Word>(address, RBusDevice::VR4300_UNCACHED), 8L)};
+  }
+
+  auto applyScript() -> void {
+    auto it = script.find(viFrames);
+    if(it != script.end()) current = it->second;
+  }
+
+  auto loadScript(const string& path) -> void {
+    auto text = string::read(path);
+    for(auto& line : nall::split(text, "\n")) {
+      auto l = line.strip();
+      if(!l || l.beginsWith("#")) continue;
+      auto parts = nall::split(l, " ", 1L);
+      u64 frame = parts[0].natural();
+      InputState st;
+      if(parts.size() > 1) for(auto& tok : nall::split(parts[1], ",")) {
+        auto t = tok.strip();
+        if(t == "A") st.a = 1; else if(t == "B") st.b = 1; else if(t == "Z") st.z = 1;
+        else if(t == "Start") st.start = 1; else if(t == "Up") st.up = 1; else if(t == "Down") st.down = 1;
+        else if(t == "Left") st.left = 1; else if(t == "Right") st.right = 1; else if(t == "L") st.l = 1;
+        else if(t == "R") st.r = 1; else if(t == "CU") st.cu = 1; else if(t == "CD") st.cd = 1;
+        else if(t == "CL") st.cl = 1; else if(t == "CR") st.cr = 1;
+        else if(t.beginsWith("X=")) st.x = (s8)t.slice(2).integer();
+        else if(t.beginsWith("Y=")) st.y = (s8)t.slice(2).integer();
+      }
+      script[frame] = st;
+    }
+  }
+};
+
+Harness harness;
+
+}
+
+static string savePath, loadPath, dumpPath;
+static u64 silhouetteEvery = 0;
+static std::vector<u8> silhouette(320 * 240 * 3);
+static std::vector<std::pair<u32, u32>> pokes;
+static u64 saveFrame = 0, dumpFrame = 0;
+static std::vector<u64> dumpFrames;
+static std::vector<string> modelFiles;
+
+int main(int argc, char** argv) {
+  if(argc < 3) { print("usage: headless <rom> <vi-frames> [--watch ADDR[:fmt]]... [--input FILE] [--dump-every N] [--quiet]\n"); return 1; }
