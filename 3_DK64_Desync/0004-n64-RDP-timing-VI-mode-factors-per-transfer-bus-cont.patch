diff --git a/ares/n64/cpu/cpu.cpp b/ares/n64/cpu/cpu.cpp
index bacdae50..6c0a21b1 100644
--- a/ares/n64/cpu/cpu.cpp
+++ b/ares/n64/cpu/cpu.cpp
@@ -83,6 +83,7 @@ auto CPU::flushCount() -> void {
 auto CPU::synchronize() -> void {
   auto clocks = Thread::clock;
   auto counted = countClock;
+  clockEpoch += clocks;
   Thread::clock = 0;
   countClock = 0;
   jitClockTarget = 0;
@@ -192,13 +193,27 @@ auto CPU::icacheFillLine(u64 vaddr, u32 paddr) -> void {
   icache.line(vaddr).fill(paddr, *this);
 }
 
-auto CPU::rdpBusyStall(u32 cycles) -> u32 {
-  return rdp.timing.enable && rdp.timing.pending && !rdp.command.freeze ? cycles : 0;
+auto CPU::rdpBusyStall(u32 cycles, f64 rdpClocks) -> u32 {
+  u32 total = 0;
+  if(rdp.timing.enable && vi.active() && vi.io.antialias < 2) total += viStallCycles;  //the VI's three-line fetch
+  if(rdp.timing.enable && rdp.timing.pending && !rdp.command.freeze) {
+    rdp.timingDelay(rdpClocks * rdp.contendScale());  //and the RDP loses the bus for the transfer
+    total += cycles;
+  }
+  return total;
+}
+
+auto CPU::icacheBusyStall() -> u32 {
+  viStallCycles = ViStallIFill;
+  u32 r = rdpBusyStall(ICacheFillStall, rdp.timing.contendCpuI);
+  viStallCycles = ViStallFill;
+  return r;
 }
 
 //the recompiler's inline instruction cache fill: the stall part of the fill time
 auto CPU::icacheStall() -> void {
-  if(u32 cycles = rdpBusyStall(ICacheFillStall)) step(cycles * 2);
+  busWait();
+  if(u32 cycles = rdpBusyStall(ICacheFillStall, rdp.timing.contendCpuI)) step(cycles * 2);
 }
 
 template<bool Recompiled>
diff --git a/ares/n64/cpu/cpu.hpp b/ares/n64/cpu/cpu.hpp
index f585846f..dc533cac 100644
--- a/ares/n64/cpu/cpu.hpp
+++ b/ares/n64/cpu/cpu.hpp
@@ -54,12 +54,27 @@ struct CPU : Thread {
   auto raiseCoprocessor1Exception() -> void;
   auto icacheFillLine(u64 vaddr, u32 paddr) -> void;
 
-  //cache line transfers wait for RDRAM behind the RDP while it is drawing (measured on
-  //hardware with rdp_timing v8: an instruction cache fill takes 10 CPU cycles longer, a
-  //data cache fill 4, a data cache write-back 12; otherwise the CPU is not slowed down)
-  auto rdpBusyStall(u32 cycles) -> u32;
+  //cache line transfers wait for RDRAM behind the RDP while it is drawing, and behind the VI's
+  //framebuffer fetch in the anti-aliased (divot/dedither) VI modes; measured on hardware with the
+  //rdp_timing test ROMs (v8/v10/v12): under a drawing RDP an instruction cache fill takes 6 CPU
+  //cycles longer, a data cache fill 5, a data cache write-back 11; in the games' VI mode another
+  //6/6/2. Each transfer in turn costs the RDP some clocks (rdp.timing.contendCpu*).
+  auto rdpBusyStall(u32 cycles, f64 rdpClocks) -> u32;
   auto icacheStall() -> void;
-  enum : u32 { ICacheFillStall = 10, DCacheFillStall = 4, DCacheWriteBackStall = 12 };
+  auto icacheBusyStall() -> u32;
+  enum : u32 { ICacheFillStall = 6, DCacheFillStall = 5, DCacheWriteBackStall = 11 };
+  enum : u32 { ICacheFillCycles = 48, DCacheFillCycles = 40, DCacheWriteBackCycles = 25 };  //cpu_timing v14: fill 41 incl. the load, write-back 25
+  enum : u32 { ViStallFill = 6, ViStallIFill = 6, ViStallWriteBack = 2 };
+  u32 viStallCycles = ViStallFill;  //the VI part of the stall for the transfer in progress
+  //a dirty line is filled first and written back from the write buffer afterwards; the CPU pays
+  //'WriteBufferCycles' and the next line transfer waits until the bus is free again (v14: a dirty
+  //miss costs 66 cycles against 41 for a clean one)
+  enum : u32 { WriteBufferCycles = 4 };
+  s64 clockEpoch = 0;          //Thread::clock is reset at every synchronize(); epoch + clock is monotonic
+  s64 busFreeAt = 0;
+  bool wbPending = false;
+  auto busNow() const -> s64 { return clockEpoch + Thread::clock; }
+  auto busWait() -> void { s64 now = busNow(); if(busFreeAt > now) step((u32)(busFreeAt - now)); }
 
   auto power(bool reset) -> void;
 
@@ -213,7 +228,8 @@ struct CPU : Thread {
       }
 
       auto fill(u32 paddr, CPU& cpu) -> void {
-        cpu.step((48 + cpu.rdpBusyStall(ICacheFillStall)) * 2);
+        cpu.busWait();
+        cpu.step((ICacheFillCycles + cpu.icacheBusyStall()) * 2);
         const u32 tag = paddr & ~0x0000'0fffu;
         tagKey = tag;
         setValid(true);
diff --git a/ares/n64/cpu/dcache.cpp b/ares/n64/cpu/dcache.cpp
index 7f8ac0e1..ae205855 100644
--- a/ares/n64/cpu/dcache.cpp
+++ b/ares/n64/cpu/dcache.cpp
@@ -4,7 +4,15 @@ auto CPU::DataCache::Line::hit(u32 paddr) const -> bool {
 }
 
 auto CPU::DataCache::Line::fill(u32 paddr) -> void {
-  cpu.step((40 + cpu.rdpBusyStall(DCacheFillStall)) * 2);
+  cpu.busWait();
+  cpu.step((CPU::DCacheFillCycles + cpu.rdpBusyStall(CPU::DCacheFillStall, rdp.timing.contendCpu)) * 2);
+  if(cpu.wbPending) {
+    //the line evicted by this fill is written from the write buffer after the fill; the bus stays busy
+    cpu.wbPending = false;
+    cpu.viStallCycles = CPU::ViStallWriteBack;
+    cpu.busFreeAt = cpu.busNow() + (CPU::DCacheWriteBackCycles + cpu.rdpBusyStall(CPU::DCacheWriteBackStall, rdp.timing.contendCpuW)) * 2;
+    cpu.viStallCycles = CPU::ViStallFill;
+  }
   const u32 tag = paddr & ~0x0000'0fffu;
   dirty  = 0;
   tagKey = tag;
@@ -13,7 +21,9 @@ auto CPU::DataCache::Line::fill(u32 paddr) -> void {
 }
 
 auto CPU::DataCache::Line::writeBack() -> void {
-  cpu.step((40 + cpu.rdpBusyStall(DCacheWriteBackStall)) * 2);
+  if(cpu.wbPending) cpu.busWait();  //two evictions without a fill between them: the buffer holds one line
+  cpu.step(CPU::WriteBufferCycles * 2);
+  cpu.wbPending = true;
   const u32 tag = tagKey & ~0x0000'0fffu;
   cpu.busWriteBurst<DCache>(tag | index, words);
 }
diff --git a/ares/n64/rdp/rdp.hpp b/ares/n64/rdp/rdp.hpp
index 83df2c10..20aba09b 100644
--- a/ares/n64/rdp/rdp.hpp
+++ b/ares/n64/rdp/rdp.hpp
