 }
 
-//how much the VI's framebuffer fetch slows the RDP in the current VI mode (see rdp.hpp)
+//how much the VI's framebuffer fetch slows the RDP just now: nothing while the VI is outside the picture
 auto RDP::viModeFactor() -> f64 {
+  return vi.picture() ? viPictureFactor() : 1.0;
+}
+
+//a span or a load in AA modes 0 / 1 / 3: priced as if the VI read the picture all the time; the part it adds is kept
+//apart (timing.pendingVi) and not spent while the VI is outside the picture (timingStep)
+auto RDP::timingVi(f64 cost) -> f64 {
+  if(vi.io.antialias == 2) return cost;  //AA mode 2: on the whole list (timingAdd)
+  f64 part = cost * (viPictureFactor() - 1.0);
+  timing.viPart += part;
+  return cost + part;
+}
+
+//how much the VI's framebuffer fetch slows the RDP in the current VI mode while it reads the picture (see rdp.hpp)
+auto RDP::viPictureFactor() -> f64 {
   if(!vi.active()) return 1.0;
   f64 f = vi.io.antialias == 3 ? timing.viFactorAA3 : vi.io.antialias == 2 ? timing.viFactorAA2 : timing.viFactorAA0;
   u32 bytes = ((u32)vi.io.width ? (u32)vi.io.width : 320u) * (vi.io.colorDepth == 3 ? 4u : 2u);
   if(bytes > 640 && vi.io.antialias < 2) f = 1.0 + (f - 1.0) * (1.0 + timing.viWidthScale * ((f64)bytes / 640.0 - 1.0));
-  return f;
+  return 1.0 + (f - 1.0) * timing.viPicture;
 }
 
 //what a span or load costs in a running game relative to the idle-console tables
 auto RDP::timingScale(bool memoryBound) -> f64 {
-  f64 f = memoryBound ? timing.contentionZ : timing.contentionPlain;
-  if(vi.io.antialias != 2) f *= viModeFactor();  //AA mode 2: on the whole list (timingAdd)
-  return f;
+  return memoryBound ? timing.contentionZ : timing.contentionPlain;  //the VI's part: timingVi
 }
 
 //what a bus transfer of another master costs the RDP, scaled by the VI's own traffic (rdp_timing v56)
@@ -293,7 +308,7 @@ auto RDP::timingSpan(s32 x, s32 y, u32 pixels, bool rectangle) -> f64 {
   //other bus masters (CPU, RSP, VI) lengthen every span: measured as a factor on the span
   f64 pipe = pixels * timing.pipeCycles;
   if(cost < pipe) cost = pipe;
-  cost *= timingScale(timing.memoryBound);
+  cost = timingVi(cost * timingScale(timing.memoryBound));
   if(timing.memoryBound) {
     cost += timing.spanPenalty;
     //with the pixels outside the scissor charged (timingTriangle), the per-span prices can follow the
@@ -558,9 +573,25 @@ auto RDP::timingSyncFull() -> void {
 //advance the RDP by up to 'clocks' system clocks of queued work; returns the clocks consumed
 auto RDP::timingStep(u32 clocks) -> u32 {
   if(timing.pending == 0) return 0;
-  if((u64)clocks > timing.pending) clocks = (u32)timing.pending;
-  timing.pending -= clocks;
-  timing.completed += clocks;
+  u64 work = clocks;
+  if(timing.pendingVi > 0.0 && !vi.picture()) {
+    //the VI is outside the picture: the queued work goes without the part the VI's traffic adds to it
+    f64 rest = max(1.0, (f64)timing.pending - timing.pendingVi);
+    f64 done = clocks * ((f64)timing.pending / rest) + timing.viCarry;
+    work = (u64)done;
+    timing.viCarry = done - (f64)work;
+    if(work > timing.pending) {
+      clocks = max(1u, (u32)(rest + 0.5));  //what is left takes its time without the VI's part
+      work = timing.pending;
+      timing.viCarry = 0.0;
+    }
+  } else if(work > timing.pending) {
+    work = timing.pending;
+    clocks = (u32)work;
+  }
+  timing.pendingVi = work < timing.pending ? timing.pendingVi * (1.0 - (f64)work / (f64)timing.pending) : 0.0;
+  timing.pending -= work;
+  timing.completed += work;
   while(timing.syncQueued && timing.completed >= timing.syncTargets[0]) {
     timing.syncQueued--;
     for(u32 n : range(timing.syncQueued)) timing.syncTargets[n] = timing.syncTargets[n + 1];
@@ -658,7 +689,7 @@ auto RDP::timingCommand(const u64* ops, u32 length) -> void {
