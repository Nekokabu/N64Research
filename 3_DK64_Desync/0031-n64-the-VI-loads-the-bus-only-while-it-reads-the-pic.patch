diff --git a/ares/n64/cpu/cpu.cpp b/ares/n64/cpu/cpu.cpp
index a652a31c..e0a2ab4f 100644
--- a/ares/n64/cpu/cpu.cpp
+++ b/ares/n64/cpu/cpu.cpp
@@ -195,7 +195,12 @@ auto CPU::icacheFillLine(u64 vaddr, u32 paddr) -> void {
 
 auto CPU::rdpBusyStall(u32 cycles, f64 rdpClocks, u32 kind, u32 address) -> u32 {
   u32 total = 0;
-  if(rdp.timing.enable && vi.active() && vi.io.antialias < 2) total += viStallCycles;  //the VI's three-line fetch
+  if(rdp.timing.enable && vi.picture() && vi.io.antialias < 2) {  //the VI's three-line fetch, while it reads the picture
+    viStallCarry += viStallCycles * rdp.timing.viPicture;
+    u32 stall = (u32)viStallCarry;
+    viStallCarry -= stall;
+    total += stall;
+  }
   if(rdp.timing.enable && rsp.dma.busy.any()) {  //an SP DMA in flight: the two transfers delay each other (rsp_timing v19)
     rsp.dma.clock -= RSP::DmaCpuPenaltyClocks;
     total += RSP::DmaCpuStallCycles;
diff --git a/ares/n64/cpu/cpu.hpp b/ares/n64/cpu/cpu.hpp
index 06add39f..ffc813ff 100644
--- a/ares/n64/cpu/cpu.hpp
+++ b/ares/n64/cpu/cpu.hpp
@@ -66,6 +66,7 @@ struct CPU : Thread {
   enum : u32 { ICacheFillCycles = 48, DCacheFillCycles = 40, DCacheWriteBackCycles = 25 };  //cpu_timing v14: fill 41 incl. the load, write-back 25
   enum : u32 { ViStallFill = 6, ViStallIFill = 6, ViStallWriteBack = 2 };
   u32 viStallCycles = ViStallFill;  //the VI part of the stall for the transfer in progress
+  f64 viStallCarry = 0.0;           //its fraction of a cycle carried to the next transfer
   //The write buffer (cpu_timing v14/v18). Stores that leave the CPU (uncached RDRAM, RCP registers,
