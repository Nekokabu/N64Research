@@ -127,6 +129,14 @@ struct RDP : Thread, Memory::RCP<RDP> {
     //output line) +0.4%, mode 2 (resample) +3%, modes 0/1 (anti-aliased with divot: three lines per output
     //line) +11.7% at 320x16-bit, +32% at 640x16-bit; mode 2 does not grow with the line (1280 pixels: +3%)
     f64    viFactorAA3 = 1.004, viFactorAA2 = 1.03, viFactorAA0 = 1.117;
+    //The factors above (and the VI parts of the losses below) were measured as the time of a whole list or task with the VI
+    //on over that with it off. But the VI reads RDRAM only on the lines of the picture (VI::picture): a list that runs
+    //through a vertical blanking, 0.097 VI long, loses less of its time than one that runs between two of them. The
+    //replays of task_timing start at a known line (half-line 333 of 525) and spend 12 to 17% of their time in the blanking;
+    //a game starts its graphics task just after the blanking (Beetle Adventure Racing 0.08 VI after the VI interrupt), so a
+    //task shorter than 0.89 VI never sees one. Inside the picture every VI part is this much larger, outside it is gone
+    //(task_timing v26: with 1.16 the replays of six tasks keep their measured time).
+    f64    viPicture = 1.16;
     f64    viWidthScale = 1.77;    //AA 0/1: the factor over 1 grows by this per 640 bytes of line above 640: (1.324-1)/(1.117-1) = 1 + 1.77*(1280/640-1)
     //the per-transfer losses below grow with the VI factor, each kind of transfer by its own amount: loss x (1 + (factor - 1) x scale).
     //rdp_timing v56 (SP DMA and CPU loads beside four game lists, VI off and in the title's mode, the VI checked to be
@@ -243,6 +253,9 @@ struct RDP : Thread, Memory::RCP<RDP> {
     u64    submitted;              //total work submitted
     u64    completed;              //total work completed
     u64    pending;                //submitted - completed
